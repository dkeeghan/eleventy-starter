{#
GLOBAL FOOTER
--------------
Contains the page footer
#}

{% import "components/content/cc14-social-links.njk" as socialLinks with context %}

{# HEAD #}
{% macro render() %}
<!-- START Global Footer -->
<footer class="g-footer">
	<div class="l-padding">
		<div class="_cols">
			{% for navItem in demoContent.footer.nav -%}
				<div class="_col is-nav-item">
					<h3 class="_heading"><a href="{{navItem.href}}">{{ navItem.text }}</a></h3>
					<ul class="_children">
						{% for child in navItem.children -%}
						<li><a href="{{child.href}}">{{ child.text }}</a></li>
						{%- endfor %}
					</ul>
				</div>
			{%- endfor %}
			<div class="_col is-social">
				<h3 class="_heading">Connect with us</h3>

				{{ socialLinks.renderList(demoContent.footer.social, false) }}
			</div>
		</div>
	</div>

	<div class="_legal">
		<div class="l-padding _content">
			<ul class="_links">
				{% for link in demoContent.footer.legal -%}
					<li><a href="{{link.href}}">{{link.text}}</a></li>
				{%- endfor %}
			</ul>
			<p class="_copyright">{{ demoContent.footer.copyright | safe }}</p>
		</div>
	</div>
</footer>
<!-- END Global Footer -->
{% endmacro %}
