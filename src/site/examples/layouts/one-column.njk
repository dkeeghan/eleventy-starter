---
title: One Column Layout
eleventyNavigation:
  key: One Column
  parent: Layouts
  status: done
  order: 1
---

{% extends "layouts/one-column.njk" %}

{% import "components/hero/hc01-page-header.njk" as pageHeader with context %}
{% import "components/global/gc03-breadcrumbs.njk" as breadcrumbs with context %}

{% block above %}
	{{ breadcrumbs.render() }}

	{{ pageHeader.render(title) }}
{% endblock %}

{% block main %}
	<p>Main content gets put in here.</p>

	<h2>Extends</h2>
	{% CodePreview "njk", true %}
		{% raw %}
		{% extends "layouts/one-column.njk" %}
		{% endraw %}
	{% endCodePreview %}

	<h2>Available Blocks</h2>
	{% CodePreview "njk", true %}
		{% raw %}
		{% block above %}
			Content to be displayed above the main column
		{% endblock %}

		{% block main %}
			Content to be in the main column
		{% endblock %}

		{% block below %}
			Content to be displayed below the main column
		{% endblock %}
		{% endraw %}
	{% endCodePreview %}
{% endblock %}
