{
  "name": "cms-and-static-starter",
  "version": "0.1.0",
  "description": "A starter site for making simple CMS and Static websites using eleventy",
  "license": "UNLICENSED",
  "private": true,
  "author": {
    "name": "Deloitte Digital AU",
    "url": "https://www.deloittedigital.com.au"
  },
  "repository": {
    "type": "git",
    "url": "https://hub.deloittedigital.com.au/stash/projects/FED/repos/cms-and-static-starter"
  },
  "bugs": {
    "url": "https://hub.deloittedigital.com.au/jira/projects/CMSSTARTER/issues",
    "email": "dkeeghan@deloitte.com.au"
  },
  "engines": {
    "node": ">= 12.16.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "last 2 Firefox versions",
    "last 2 Chrome versions",
    "last 2 iOS versions",
    "last 3 Android versions",
    "last 2 ChromeAndroid versions",
    "last 2 Samsung versions",
    "not dead"
  ],
  "scripts": {
    "clean": "run-s clean:*",
    "clean:cache": "rimraf ./.cache",
    "clean:site": "rimraf ./dist",
    "icons": "npm run icons:clean && npm run icons:optimise && npm run icons:combine && npm run icons:clean",
    "icons:clean": "rimraf ./src/assets/icons/svgs-min",
    "icons:combine": "svgstore -o ./src/assets/img/icons.svg -p svg- ./src/assets/icons/svgs-min/*.svg",
    "icons:optimise": "mkdirp ./src/assets/icons/svgs-min && svgo --folder ./src/assets/icons/svgs-src --output ./src/assets/icons/svgs-min",
    "build": "run-s clean build:*",
    "build:html": "cross-env ELEVENTY_ENV=production eleventy",
    "build:assets": "cross-env NODE_ENV=production parcel build ./src/assets/css/style.scss ./src/assets/css/dev.scss ./src/assets/js/app.js --out-dir ./dist/assets --no-source-maps",
    "watch": "run-s clean:* && run-p watch:*",
    "watch:html": "cross-env ELEVENTY_ENV=development eleventy --serve --port=8080",
    "watch:assets": "cross-env NODE_ENV=development parcel watch ./src/assets/css/style.scss ./src/assets/css/dev.scss ./src/assets/js/app.js --out-dir ./dist/assets --no-hmr --public-url .",
    "start": "npm run watch"
  },
  "devDependencies": {
    "@11ty/eleventy": "^0.11.0",
    "@11ty/eleventy-navigation": "^0.1.5",
    "@11ty/eleventy-plugin-syntaxhighlight": "^3.0.1",
    "@babel/core": "^7.10.2",
    "@deloitte-digital-au/babel-preset-app": "^3.0.0",
    "@deloitte-digital-au/eslint-config": "^3.4.0",
    "@deloitte-digital-au/stylelint-config": "^2.0.1",
    "@fullhuman/postcss-purgecss": "^2.3.0",
    "core-js": "^3.6.5",
    "cross-env": "^7.0.2",
    "fs": "0.0.1-security",
    "html-minifier": "^4.0.0",
    "js-beautify": "^1.11.0",
    "npm-run-all": "^4.1.5",
    "nunjucks": "^3.2.1",
    "parcel-bundler": "^1.12.4",
    "postcss-nested": "^4.2.1",
    "prismjs": "^1.20.0",
    "rimraf": "^3.0.2",
    "sass": "^1.26.8",
    "stylelint": "^13.6.0",
    "stylelint-cli": "^1.3.0",
    "svg-sprite": "^1.5.0",
    "svgo": "^1.3.2",
    "svgstore-cli": "^1.3.2"
  },
  "dependencies": {
    "@deloitte-digital-au/ddbreakpoints": "^2.0.2",
    "dd-a11y": "git+ssh://git@dvcs.deloittedigital.com.au:22/cmsstarter/dd-a11y.git#master",
    "dd-component-container": "git+ssh://git@dvcs.deloittedigital.com.au:22/cmsstarter/dd-component-container.git#master",
    "dd-expandable": "git+ssh://git@dvcs.deloittedigital.com.au:22/cmsstarter/dd-expandable.git#master",
    "dd-offscreen": "git+ssh://git@dvcs.deloittedigital.com.au:22/cmsstarter/dd-offscreen.git#master",
    "normalize.css": "^8.0.1"
  }
}
